<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jarvis.weeklycanva</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/user/jarvis/app/scripts/weekly_canva_posts.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/user/jarvis/app</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/user/jarvis/app/scripts/weekly-canva.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/user/jarvis/app/scripts/weekly-canva.log</string>
</dict>
</plist>
